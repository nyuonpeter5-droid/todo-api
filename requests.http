@baseUrl = http://localhost:3000

### ==========================
### 0. AUTHENTICATION
### ==========================

### Login to get Access Token and set Refresh Cookie
# @name login
POST {{baseUrl}}/login
Content-Type: application/json

{
  "username": "admin",
  "password": "password123"
}

### Store the access token dynamically from the login response
@accessToken = {{login.response.body.accessToken}}


### ==========================
### 1. TODO CRUD (Happy Paths)
### ==========================

### Get all todos
GET {{baseUrl}}/todos
Authorization: Bearer {{accessToken}}

### Create a new todo item (Expect 201 Created)
# @name createTodo
POST {{baseUrl}}/todos
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Write API documentation",
  "description": "OpenAPI + README examples",
  "state": "todo"
}

### Get single todo by ID
GET {{baseUrl}}/todos/{{createTodo.response.body.id}}
Authorization: Bearer {{accessToken}}

### Filter todos by state (?state=todo)
GET {{baseUrl}}/todos?state=todo
Authorization: Bearer {{accessToken}}

### Update todo state (Expect 200 OK)
PUT {{baseUrl}}/todos/{{createTodo.response.body.id}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "state": "doing"
}

### Delete todo item (Expect 200 OK)
DELETE {{baseUrl}}/todos/{{createTodo.response.body.id}}
Authorization: Bearer {{accessToken}}


### ==========================
### 2. ERROR & VALIDATION TESTS
### ==========================

### Error: POST missing required title (Expect 400 Bad Request)
POST {{baseUrl}}/todos
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "description": "Missing title test",
  "state": "todo"
}

### Error: POST with invalid state value (Expect 400 Bad Request)
POST {{baseUrl}}/todos
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "title": "Invalid state test",
  "state": "invalid-state-value"
}

### Error: GET non-existent ID (Expect 404 Not Found)
GET {{baseUrl}}/todos/non-existent-id-12345
Authorization: Bearer {{accessToken}}

### Error: PUT update with invalid state (Expect 400 Bad Request)
PUT {{baseUrl}}/todos/{{createTodo.response.body.id}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "state": "completed"
}