const request = require('supertest');
const { app } = require('../../app');

describe('Integration Tests: Todo REST API', () => {
  let createdTodoId;

  test('GET / should return welcome message', async () => {
    const res = await request(app).get('/');
    expect(res.statusCode).toEqual(200);
    expect(res.body).toHaveProperty('message');
  });

  test('POST /todos should create a new todo item (201 Created)', async () => {
    const res = await request(app)
      .post('/todos')
      .send({
        title: 'Automated Testing',
        description: 'Writing integration tests with Supertest',
        state: 'todo'
      });

    expect(res.statusCode).toEqual(201);
    expect(res.body).toHaveProperty('id');
    expect(res.body.title).toEqual('Automated Testing');
    
    createdTodoId = res.body.id;
  });

  test('POST /todos should fail with 400 if title is missing', async () => {
    const res = await request(app)
      .post('/todos')
      .send({ description: 'No title test' });

    expect(res.statusCode).toEqual(400);
    expect(res.body).toHaveProperty('error', 'Bad Request');
  });

  test('GET /todos/:id should retrieve the created todo', async () => {
    const res = await request(app).get(`/todos/${createdTodoId}`);
    expect(res.statusCode).toEqual(200);
    expect(res.body.id).toEqual(createdTodoId);
  });

  test('GET /todos/:id should return 404 for non-existent ID', async () => {
    const res = await request(app).get('/todos/non-existent-id-999');
    expect(res.statusCode).toEqual(404);
    expect(res.body).toHaveProperty('error', 'Not Found');
  });

  test('PUT /todos/:id should update the todo state', async () => {
    const res = await request(app)
      .put(`/todos/${createdTodoId}`)
      .send({ state: 'doing' });

    expect(res.statusCode).toEqual(200);
    expect(res.body.state).toEqual('doing');
  });

  test('DELETE /todos/:id should delete the todo item', async () => {
    const res = await request(app).delete(`/todos/${createdTodoId}`);
    expect(res.statusCode).toEqual(200);
    expect(res.body).toHaveProperty('message', 'Todo item successfully deleted.');
  });
});